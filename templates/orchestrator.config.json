{
  "review": {
    "split": true
  },
  "thresholds": {
    "near_limit_pct": 25,
    "critical_limit_pct": 10
  },
  "commands": {
    "test": "",
    "lint": "",
    "typecheck": ""
  },
  "paths": {
    "include": [],
    "exclude": [
      ".git",
      "node_modules",
      "__pycache__",
      "dist",
      "build",
      ".venv"
    ]
  },
  "engines": {
    "claude": true,
    "codex": true,
    "openrouter": false
  },
  "fallback": {
    "claude_to_codex": true,
    "codex_to_claude": true,
    "require_human_review_when_both_limited": true
  },
  "openrouter": {
    "key_env": "OPENROUTER_API_KEY",
    "budget": {
      "yearly_usd": 0,
      "monthly_usd": 0,
      "weekly_usd": 0,
      "daily_usd": 0
    }
  },
  "codex": {
    "max_files_per_fallback": 5
  },
  "balance": {
    "mode": "adaptive",
    "routes": [
      "standard",
      "complex"
    ]
  },
  "models": {
    "haiku": {
      "score": 40,
      "engines": {
        "claude": "haiku"
      }
    },
    "sonnet": {
      "score": 70,
      "engines": {
        "claude": "sonnet"
      }
    },
    "opus": {
      "score": 85,
      "engines": {
        "claude": "opus"
      }
    },
    "fable": {
      "score": 95,
      "engines": {
        "claude": "claude-fable-5-2"
      }
    },
    "gpt-5.6-luna": {
      "score": 45,
